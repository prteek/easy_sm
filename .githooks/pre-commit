#!/bin/bash
# Pre-commit hook: Validate documentation on commit

# Check if any documentation files are being committed
# This includes:
# - All files under docs/ directory (commands, user-guide, examples, etc.)
# - Root-level markdown files (CLAUDE.md, README.md, DOCS_WORKFLOW.md)
# - Configuration files (mkdocs.yml, requirements-docs.txt)
DOCS_CHANGED=$(git diff --cached --name-only | grep -E '^docs/|^CLAUDE\.md|^README\.md|^DOCS_WORKFLOW\.md|^mkdocs\.yml|^requirements-docs\.txt' || true)

if [ -z "$DOCS_CHANGED" ]; then
    exit 0
fi

echo "🔍 Validating documentation..."

# Run the validation script
python3 scripts/validate_docs.py

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Documentation validation failed. Fix issues and try again."
    echo "   Run: python3 scripts/validate_docs.py"
    exit 1
fi

echo ""
exit 0
